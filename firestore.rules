rules_version = '2';

// 위클리 — Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 그대로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 시간표 문서: schedules/{uid}
    match /schedules/{uid} {
      // 단일 조회(get): 비공개가 아니면 누구나, 비공개면 본인만
      allow get: if resource == null
                 || resource.data.visibility != 'private'
                 || (request.auth != null && request.auth.uid == uid);

      // 목록 조회(list/둘러보기): 공개(public)로 설정된 것만
      allow list: if resource.data.visibility == 'public';

      // 생성/수정/삭제는 본인만
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == uid;

      // 예약: schedules/{uid}/reservations/{slotId}
      // slotId 는 "d{요일}_h{시}" 고정값 → 한 칸당 최대 1건(정원 1명)
      match /reservations/{slotId} {
        allow read: if true;

        // 문서 ID가 내부 day/hour 와 일치해야 함 → 슬롯당 1건 보장이 우회되지 않음
        function slotMatches() {
          return slotId == 'd' + string(request.resource.data.day)
                         + '_h' + string(request.resource.data.hour);
        }
        // 값 범위 및 문자열 길이 제한
        function validData() {
          return request.resource.data.day is int
                 && request.resource.data.day >= 0
                 && request.resource.data.day <= 6
                 && request.resource.data.hour is int
                 && request.resource.data.hour >= 0
                 && request.resource.data.hour <= 23
                 && request.resource.data.note is string
                 && request.resource.data.note.size() <= 200
                 && request.resource.data.byName is string
                 && request.resource.data.byName.size() <= 100
                 && request.resource.data.mark is string
                 && request.resource.data.mark.size() <= 8;
        }

        // 빈 칸일 때만 create 가 호출되고, 본인 명의로만 가능
        // status 는 반드시 'pending' — 예약자가 스스로 승인할 수 없음
        allow create: if request.auth != null
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && slotMatches()
                      && validData();

        // 예약자 본인의 수정 (내용이 바뀌면 다시 승인 대기 상태)
        allow update: if request.auth != null
                      && resource.data.byUid == request.auth.uid
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && slotMatches()
                      && validData();

        // 시간표 주인의 승인 — status 필드만 'approved' 로 변경 가능
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                      && request.resource.data.status == 'approved';

        // 예약자 본인 또는 시간표 주인이 삭제 (구버전 랜덤 ID 예약도 삭제 가능)
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.byUid
                          || request.auth.uid == uid);
      }
    }

    // 비공개 메모: privateMemos/{memoId} — 작성자 본인만 읽고 쓸 수 있음
    match /privateMemos/{memoId} {
      allow read, update, delete: if request.auth != null
                                  && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 200;
    }
  }
}
